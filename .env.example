# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Graph (tenant) names. BatchZero isolates every agency in its own FalkorDB graph.
TENANT_GRAPH=pmph_ops
TRAINING_TENANT_GRAPH=training_academy

# --- LLM ---
# provider: groq | mock
# mock = fully offline deterministic replay (used by tests + demo fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional OpenAI-compatible override (works with OpenRouter, Together, local vLLM, etc.)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
MAX_AGENT_STEPS=14
AGENT_VERBOSE=true
